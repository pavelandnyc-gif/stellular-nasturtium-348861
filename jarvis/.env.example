# ─────────────────────────────────────────────────────────────────────────────
#  JARVIS · Variables de entorno
#  Copia este archivo como `.env.local` (en tu computadora) o pega cada valor
#  en Vercel → Project → Settings → Environment Variables.
#  NUNCA subas al repositorio un archivo con valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# Dirección pública HTTPS de la app (sin barra final). Ej: https://jarvis-javier.vercel.app
APP_URL=http://localhost:3000

# ── Base de datos (PostgreSQL de Supabase) ──────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
# (puerto 6543). Si la dejas vacía, la app usa una base local de prueba en .data/
DATABASE_URL=

# ── Cuenta (Supabase Auth) ──────────────────────────────────────────────────
# Supabase → Project Settings → API. La "publishable/anon key" es pública por diseño.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Correos que pueden usar Jarvis (separados por coma). Cualquier otro recibe "no autorizado".
ALLOWED_EMAILS=tu-correo@ejemplo.com

# ── Modo local (solo para la vista previa sin Supabase) ──────────────────────
# Se usa únicamente si NEXT_PUBLIC_SUPABASE_URL está vacío.
LOCAL_AUTH_PASSWORD=
# Cadena larga y aleatoria para firmar la sesión local (genera una con: openssl rand -hex 32)
SESSION_SECRET=

# ── Inteligencia artificial (Claude, de Anthropic) ──────────────────────────
# console.anthropic.com → API Keys. Sin clave, Jarvis funciona con formularios manuales.
ANTHROPIC_API_KEY=
# Modelo configurable. Por defecto: claude-opus-5-5 (el más capaz de uso general).
# Opción más económica: claude-haiku-5-5
AI_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento: low | medium | high  (low = más rápido y barato)
AI_EFFORT=low

# ── Notificaciones Web Push (VAPID) ─────────────────────────────────────────
# Genera el par de claves con:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Un correo de contacto para los servicios push (Apple, Google, Mozilla)
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# ── Programador de avisos ───────────────────────────────────────────────────
# Secreto que debe enviar el programador (pg_cron de Supabase) al llamar a
# /api/cron/dispatch. Genera uno con: openssl rand -hex 32
CRON_SECRET=
